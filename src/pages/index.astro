---
import { getCollection } from 'astro:content';
import ButtonLink from '../components/ButtonLink.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationList from '../components/PublicationList.astro';
import { capabilities, siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => data.featured && data.status === 'public')).sort(
  (a, b) => a.data.order - b.data.order,
);
const publications = (await getCollection('publications', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);
---

<BaseLayout>
  <section class="intro">
    <div class="container">
      <a class="conference-link" href="/neurips-2026/">NeurIPS 2026 · Sydney · Workshop presenter <span>→</span></a>
      <h1>Machine learning for adaptive biomedical systems.</h1>
      <p class="intro-summary">
        I build sequential decision-making, generative modelling and simulation methods for complex biological systems—from closed-loop insulin delivery to computational neuromodulation.
      </p>
      <div class="tag-list" aria-label="Research areas">
        {siteConfig.researchTags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <div class="button-row">
        <ButtonLink href="#work" label="Featured work" primary />
        <ButtonLink href="/cv/" label="CV" />
        <ButtonLink href={siteConfig.github} label="GitHub" />
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading">
        <h2 id="work-title">Featured work</h2>
        <p>Research software and computational methods built to make difficult biomedical control problems testable, inspectable and reproducible.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section compact" aria-labelledby="capabilities-title">
    <div class="container">
      <div class="section-heading">
        <h2 id="capabilities-title">What I build</h2>
        <p>Methods and systems that connect learning algorithms to scientific models, simulation environments and real experimental constraints.</p>
      </div>
      <div class="capability-grid">
        {capabilities.map((capability) => (
          <article class="capability">
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="papers" aria-labelledby="papers-title">
    <div class="container">
      <div class="section-heading">
        <h2 id="papers-title">Selected papers</h2>
        <p>A short selection emphasizing sequential decision-making, computational modelling and adaptive biomedical systems.</p>
      </div>
      <PublicationList publications={publications} />
      <p class="more-link"><a href={siteConfig.scholar}>View all publications on Google Scholar →</a></p>
    </div>
  </section>

  <section class="section compact" aria-labelledby="about-title">
    <div class="container about-grid">
      <div>
        <h2 id="about-title">About</h2>
        <p>
          I am a machine-learning researcher interested in sequential decision-making and computational methods for complex biological systems. My work spans reinforcement learning, scientific simulation, generative modelling and biomedical applications, with an emphasis on building reproducible systems that connect methodological research with real scientific problems.
        </p>
      </div>
      <div class="contact-panel">
        <h3>Background and experience</h3>
        <p>Employment and education history are kept in the concise CV page.</p>
        <a href="/cv/">View CV →</a>
      </div>
    </div>
  </section>

  <section class="section compact" id="contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p>If you would like to discuss research systems, sequential decision-making or machine learning for biomedical science, email is the most direct route.</p>
      </div>
      <div class="contact-panel">
        <h3>Get in touch</h3>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <a href={siteConfig.github}>GitHub</a>
        <a href={siteConfig.scholar}>Google Scholar</a>
      </div>
    </div>
  </section>
</BaseLayout>
