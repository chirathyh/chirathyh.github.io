---
import { getEntry, render } from 'astro:content';
import ButtonLink from '../../components/ButtonLink.astro';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const profile = await getEntry('cv', 'profile');
if (!profile) throw new Error('The CV profile content is missing.');
const { Content } = await render(profile);
const updatedLabel = new Intl.DateTimeFormat('en-AU', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${profile.data.updated}T00:00:00Z`));
---

<BaseLayout
  title="CV — Chirath Hettiarachchi"
  description="Concise professional summary and CV download for Chirath Hettiarachchi."
>
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Curriculum vitae</span>
      <h1>CV</h1>
      <p class="page-lead">{profile.data.summary}</p>
      <div class="button-row">
        <ButtonLink
          href={siteConfig.cvAvailable ? siteConfig.cvPath : null}
          label={siteConfig.cvAvailable ? 'Download CV' : 'Download CV — PDF pending'}
          download={siteConfig.cvPath.split('/').pop()}
          primary
        />
        <ButtonLink href={`mailto:${siteConfig.email}`} label="Email" />
      </div>
      {siteConfig.cvAvailable && <p class="cv-download-note">Industry CV · 2 pages · PDF</p>}
    </div>
  </header>

  <section class="section compact">
    <div class="container">
      <div class="prose cv-summary">
        <Content />
        <p class="cv-resources">See <a href="/publications/">publications</a> and <a href="/#work">research software</a> for papers, code and project details.</p>
        <p class="cv-updated">Updated <time datetime={profile.data.updated}>{updatedLabel}</time>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
