---
import { getImage, Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const visual = data.homepageVisual;
const poster = visual?.video
  ? await getImage({ src: visual.image, width: 1080, format: 'webp' })
  : null;
const route = `/projects/${project.id}/`;
const externalLinks = [
  ['Paper', data.links.paper],
  ['CAPSML', data.links.demo],
  ['Code', data.links.code],
  ['G2P2C', data.links.g2p2c],
  ['GluCoEnv', data.links.glucoenv],
  ['RL4T1D', data.links.rl4t1d],
  ['NeurIPS 2026', data.links.neurips],
].filter((link): link is [string, string] => Boolean(link[1]));
---

<article class="project-card">
  <header class="project-card-header">
    <div>
      <h3><a href={route}>{data.title}</a></h3>
      <p class="subtitle">{data.subtitle}</p>
    </div>
    <a class="project-detail-link" href={route}>Full project →</a>
  </header>

  <div class="project-summary-grid">
    <div class="project-overview">
      <p class="project-summary">{data.summary}</p>
      <p class="secondary">{data.secondary}</p>
    </div>

    <div class="project-evidence">
      <p class="project-evidence-label">Technical summary</p>
      <ul>
        {data.technicalHighlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>
  </div>

  {visual && (
    <figure class="project-home-visual">
      {visual.video && poster ? (
        <>
          <div class="project-video-preview">
            <Picture
              src={visual.image}
              alt={visual.alt}
              widths={[480, 800, 1080]}
              sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 880px) calc(100vw - 6rem), (max-width: 1184px) calc(100vw - 22rem), 800px"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
            />
          </div>
          <details class="project-animation">
            <summary>Watch glucose-control animation · 39 seconds</summary>
            <video
              controls
              playsinline
              preload="none"
              poster={poster.src}
              width={visual.image.width}
              height={visual.image.height}
              aria-label={visual.alt}
              aria-describedby={`${project.id}-visual-caption`}
            >
              <source src={visual.video.mp4} type="video/mp4" />
              {visual.video.webm && <source src={visual.video.webm} type="video/webm" />}
              <p><a href={visual.video.mp4}>Watch the glucose-control simulation</a>.</p>
            </video>
          </details>
        </>
      ) : (
        <a class="project-figure-link" href={route} aria-label={`Explore the ${data.title} framework in detail`}>
          <Picture
            src={visual.image}
            alt={visual.alt}
            widths={[480, 800, 1440]}
            sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 880px) calc(100vw - 6rem), (max-width: 1184px) calc(100vw - 22rem), 800px"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
          />
        </a>
      )}
      <figcaption id={`${project.id}-visual-caption`}>{visual.caption}</figcaption>
    </figure>
  )}

  <div class="tag-list" aria-label="Technologies and topics">
    {data.tags.slice(0, 6).map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <div class="link-row">
    {externalLinks.map(([label, href]) => (
      <a class:list={['text-link', { internal: href.startsWith('/') }]} href={href}>{label}</a>
    ))}
  </div>
</article>
