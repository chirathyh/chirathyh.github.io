---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const route = `/projects/${project.id}/`;
const externalLinks = [
  ['Paper', data.links.paper],
  ['CAPSML', data.links.demo],
  ['Code', data.links.code],
  ['G2P2C', data.links.g2p2c],
  ['GluCoEnv', data.links.glucoenv],
  ['RL4T1D', data.links.rl4t1d],
  ['NeurIPS 2026', data.links.neurips],
].filter((link): link is [string, string] => Boolean(link[1]));
---

<article class="project-card">
  <header class="project-card-header">
    <div>
      <h3><a href={route}>{data.title}</a></h3>
      <p class="subtitle">{data.subtitle}</p>
    </div>
    <a class="project-detail-link" href={route}>Full project →</a>
  </header>

  <div class="project-summary-grid">
    <div class="project-overview">
      <p class="project-summary">{data.summary}</p>
      <p class="secondary">{data.secondary}</p>
    </div>

    <div class="project-evidence">
      <p class="project-evidence-label">Technical summary</p>
      <ul>
        {data.technicalHighlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>
  </div>

  <div class="tag-list" aria-label="Technologies and topics">
    {data.tags.slice(0, 6).map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <div class="link-row">
    {externalLinks.map(([label, href]) => (
      <a class:list={['text-link', { internal: href.startsWith('/') }]} href={href}>{label}</a>
    ))}
  </div>
</article>
