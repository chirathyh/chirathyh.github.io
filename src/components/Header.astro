---
import { siteConfig } from '../config/site';
import Link from './Link.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav class="primary-nav" aria-label="Primary navigation">
    {siteConfig.nav.map((item) => {
      const path = item.href.split('#')[0];
      const active = item.href === '/#work'
        ? currentPath === '/'
        : item.href.startsWith('/#') || item.href.startsWith('http')
          ? false
          : Boolean(path && currentPath.startsWith(path));
      return <Link class:list={{ active }} href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</Link>;
    })}
  </nav>
</header>
