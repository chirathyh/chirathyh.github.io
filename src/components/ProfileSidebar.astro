---
import { Image } from 'astro:assets';
import portrait from '../assets/images/profile.png';
import { siteConfig } from '../config/site';
import Link from './Link.astro';

// Scholar, ORCID and X glyphs: Simple Icons (CC0), https://simpleicons.org/.
// LinkedIn glyph: Font Awesome Free 6 (CC BY 4.0), https://fontawesome.com/license/free.
const profileLinks = [
  { label: 'Email', href: `mailto:${siteConfig.email}` },
  { label: 'Google Scholar', href: siteConfig.scholar, viewBox: '0 0 24 24', path: 'M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z' },
  { label: 'ORCID', href: siteConfig.orcid, viewBox: '0 0 24 24', path: 'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z' },
  { label: 'LinkedIn', href: siteConfig.linkedin, viewBox: '0 0 448 512', path: 'M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z' },
  { label: 'X (@chirathyh)', href: 'https://x.com/chirathyh', viewBox: '0 0 24 24', path: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z' },
];
---

<aside class="profile-sidebar" aria-label="Profile">
  <div class="profile-inner">
    <a class="profile-portrait" href="/" aria-label="Chirath Hettiarachchi, home">
      <Image
        src={portrait}
        alt="Portrait of Chirath Hettiarachchi"
        width={112}
        height={112}
        densities={[1, 2]}
        format="webp"
        loading="eager"
      />
    </a>
    <div class="profile-copy">
      <a class="profile-name" href="/">{siteConfig.name}</a>
      <p class="profile-role">Research Scientist | Engineer</p>
      <nav class="profile-links" aria-label="Profile links">
        {profileLinks.map(({ label, href, viewBox, path }) => (
          <Link class="profile-icon-link" href={href} title={label}>
            {path ? (
              <svg viewBox={viewBox} fill="currentColor" aria-hidden="true" focusable="false">
                <path d={path} />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m4 7 8 6 8-6" />
              </svg>
            )}
            <span class="sr-only">{label}</span>
          </Link>
        ))}
      </nav>
    </div>
  </div>
</aside>

<style>
  .profile-links {
    gap: 0.15rem;
  }

  .profile-links :global(.profile-icon-link) {
    display: inline-grid;
    flex: 0 0 2.25rem;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.3rem;
  }

  .profile-links :global(.profile-icon-link:hover) {
    color: var(--accent-dark);
    background: var(--surface);
  }

  .profile-links :global(.profile-icon-link:focus-visible) {
    outline-offset: 1px;
  }

  .profile-links svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
